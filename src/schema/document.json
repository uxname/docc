{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docc document",
  "description": "A docc source document: one JSON file in docs/src. The id is the file name without extension. Extra free fields are allowed.",
  "type": "object",
  "required": ["title"],
  "properties": {
    "title": { "type": "string", "pattern": "\\S", "description": "Non-empty heading of the document." },
    "kind": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Document kind; selects docs/schemas/<kind>.json." },
    "status": { "type": "string", "description": "Allowed values are set by the kind schema." },
    "parent": { "type": "string", "description": "Id of the parent document." },
    "body": {
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "anyOf": [{ "type": "string" }, { "type": "object", "required": ["$input"] }] } }
      ],
      "description": "Main text: a string or an array of paragraphs, printed right under the title. An item {\"$input\": ...} is a form field of the HTML file (DOC111)."
    },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "notes": { "type": "array", "items": { "type": "string" }, "description": "Hidden notes for agents; printed only by the audit build (build --full)." },
    "hidden": { "type": "boolean", "description": "true: checked but not printed to out/." },
    "order": { "type": "number", "description": "Position among siblings." },
    "docIgnore": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "reason"],
        "properties": {
          "rule": { "type": "string" },
          "reason": { "type": "string" },
          "path": { "type": "string" }
        },
        "additionalProperties": false
      },
      "description": "Suppressions; every entry needs a reason."
    },
    "$comments": {
      "type": "array",
      "description": "The readers' comments, written by docc comments apply (DOC112, DOC215). Each is about the block at the JSON Pointer at; an answer to a form field has input and answer instead of text. A handled comment is deleted.",
      "items": {
        "type": "object",
        "required": ["id", "at", "quote", "author", "created"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "pattern": "^/" },
          "quote": { "type": "string" },
          "fragment": { "type": "string" },
          "prefix": { "type": "string" },
          "suffix": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 1 },
          "answer": { "type": "array", "items": { "type": "string" } },
          "author": { "type": "string" },
          "email": { "type": "string" },
          "created": { "type": "string", "format": "date-time" },
          "edited": { "type": "string", "format": "date-time" }
        },
        "oneOf": [{ "required": ["text"] }, { "required": ["input", "answer"] }]
      }
    }
  }
}
