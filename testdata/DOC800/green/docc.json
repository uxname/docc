{
  "customRules": [
    { "id": "custom/no-vague-quantity", "level": "warn", "kind": "requirement", "given": "/statement",
      "forbid": "(?i)(^|[^\\p{L}])несколько($|[^\\p{L}])", "message": "Replace «несколько» with a number" },
    { "id": "custom/needs-must", "level": "error", "kind": "requirement", "given": "/statement",
      "require": "(?i)(^|[^\\p{L}])must($|[^\\p{L}])", "message": "A requirement statement must contain \"must\"" }
  ]
}
