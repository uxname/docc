{
  "title": "Index",
  "kind": "page",
  "key": "IND",
  "body": [
    "Text. ^IND-1",
    { "$input": "radio", "label": "No id", "options": ["Yes", "No"] },
    { "$input": "select", "id": "kind", "label": "Unknown kind" },
    { "$input": "radio", "id": "one", "label": "One option", "options": ["Yes"] },
    { "$input": "checkbox", "id": "same", "label": "Same options", "options": ["A", "A"] },
    { "$input": "text", "id": "same", "label": "Used id" },
    { "$input": "text", "id": "opts", "label": "Text with options", "options": ["A"] },
    { "$input": "text", "id": "empty", "label": 5 },
    { "$input": "text", "id": "extra", "label": "Extra", "hint": "x" },
    { "$input": "rating", "id": "rate-rec", "label": "Rate", "options": [{ "label": "A", "recommended": true }] },
    { "$input": "radio", "id": "two-rec", "label": "Two", "options": [{ "label": "A", "recommended": true }, { "label": "B", "recommended": true }] },
    { "$input": "radio", "id": "labels", "label": "Labels", "options": ["A", "B"], "labels": ["X", "Y", "Z"] },
    { "$input": "rating", "id": "two-labels", "label": "Two labels", "options": ["A"], "labels": ["X", "Y"] },
    { "$input": "checkbox", "id": "why", "label": "Unknown", "options": [{ "label": "A", "why": "x" }] },
    { "$input": "checkbox", "id": "no-label", "label": "No label", "options": [{ "description": "x" }] },
    { "$input": "checkbox", "id": "picture", "label": "Picture", "options": [{ "label": "A", "description": "![x](https://example.com/x.png)" }] },
    { "$input": "radio", "id": "same-label", "label": "Same", "options": ["A", { "label": "A" }] },
    { "$input": "radio", "id": "rec-str", "label": "Recommended", "options": [{ "label": "A", "recommended": "yes" }, "B"] }
  ],
  "alone": { "$input": "text", "id": "alone", "label": "Not in an array" },
  "list": [{ "name": "a" }, { "$input": "text", "id": "in-list", "label": "In a list" }]
}
