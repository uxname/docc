{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docc.json",
  "description": "Configuration of docc. Every field is optional; unknown keys are errors.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "src": { "type": "string", "default": "docs/src", "description": "Source documents, relative to the project root." },
    "out": { "type": "string", "default": "docs/out", "description": "Generated Markdown (committed)." },
    "schemas": { "type": "string", "default": "docs/schemas", "description": "Kind schemas: <kind>.json." },
    "outFull": { "type": "string", "default": "docs/out-full", "description": "Audit build (docc build --full), not committed." },
    "roots": { "type": "array", "items": { "type": "string" }, "minItems": 1, "default": ["index"], "description": "Ids of the root documents; reachability is counted from them." },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "Registry of allowed tags; absent: no registry." },
    "recommended": { "type": "boolean", "default": true, "description": "false turns the recommended preset off; core rules stay on." },
    "maxWarnings": { "type": "integer", "minimum": 0, "description": "Exit code 1 when there are more warnings than this." },
    "rules": {
      "type": "object",
      "description": "Rule code, rule name or group name to a level or an object with parameters.",
      "propertyNames": { "enum": [] },
      "additionalProperties": { "$ref": "#/$defs/ruleSetting" }
    },
    "customRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "level", "message", "given"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^custom/[a-z0-9-]+$" },
          "level": { "$ref": "#/$defs/level" },
          "message": { "type": "string" },
          "hint": { "type": "string" },
          "kind": { "type": "string" },
          "given": { "type": "string", "pattern": "^/", "description": "JSON pointer to a string field; * matches any array element or object key." },
          "forbid": { "type": "string", "description": "Go (RE2) regular expression; a match is a violation." },
          "require": { "type": "string", "description": "Go (RE2) regular expression that must match." }
        },
        "oneOf": [{ "required": ["forbid"] }, { "required": ["require"] }]
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scan": { "type": "array", "items": { "type": "string" }, "description": "Masks from the project root for @covers tags; absent: DOC401 does not run." }
      }
    }
  },
  "$defs": {
    "level": { "enum": ["error", "warn", "off"] },
    "ruleSetting": {
      "oneOf": [
        { "$ref": "#/$defs/level" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": { "$ref": "#/$defs/level" },
            "words": { "type": "array", "items": { "type": "string" } },
            "allow": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    }
  }
}
